{
  "configVersion": "v3",
  "app": {
    "appId": 1123172,
    "appName": "PacePilot",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "165cm",
    "description": "A focused Pomodoro timer for your wrist"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.alarm",
    "device:os.notification",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "4.2",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "pace": {
      "module": {
        "page": {
          "pages": [
            "page/home",
            "page/custom",
            "page/timer",
            "page/complete",
            "page/history",
            "page/history-day"
          ]
        },
        "app-service": {
          "services": [
            "app-service/boundary"
          ]
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        },
        {
          "st": "r",
          "dw": 466
        },
        {
          "st": "r",
          "dw": 454
        },
        {
          "st": "s",
          "dw": 390
        }
      ]
    }
  },
  "i18n": {
    "ja-JP": {
      "appName": "PacePilot"
    },
    "zh-CN": {
      "appName": "PacePilot"
    },
    "zh-TW": {
      "appName": "PacePilot"
    },
    "en-US": {
      "appName": "PacePilot"
    }
  },
  "defaultLanguage": "en-US"
}
